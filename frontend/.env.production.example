# Produção — RestTec (albatecrest)
# No servidor: o CI copia este arquivo para .env.production se ainda não existir
# NEXT_PUBLIC_API_URL vazia = requisições relativas (/api/...) via Nginx
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://dist.albatec.com.br

# URL interna para Route Handlers do Next.js (servidor → Laravel na mesma VM)
API_URL_INTERNAL=http://127.0.0.1:8002

# WebSocket — Laravel Reverb via HTTPS/WSS
NEXT_PUBLIC_REVERB_HOST=dist.albatec.com.br
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# Mercado Pago (chave pública)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

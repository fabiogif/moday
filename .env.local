# Desenvolvimento local — PHP no host (fora do Docker)
# Uso: cp .env.local .env  (ou merge manual)
# Com Laravel Sail: troque DB_HOST=mysql e REDIS_HOST=redis

APP_NAME=DistribTec
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_STORE=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_CLUSTER=false
REDIS_QUEUE_CONNECTION=queue

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@distribtec.com.br"
MAIL_FROM_NAME="DistribTec"

JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

PUSHER_APP_ID=distribtec
PUSHER_APP_KEY=distribtec-key
PUSHER_APP_SECRET=distribtec-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=8080
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

MERCADOPAGO_ACCESS_TOKEN=TEST-1767045296281064-061210-1564aab2cd9bf1355090f5275e24f5fb-1133737726
MERCADOPAGO_PUBLIC_KEY=TEST-8647dffc-eb64-49ef-a180-a6b6e640acd0
MERCADOPAGO_WEBHOOK_SECRET=

WWWUSER=1000
WWWGROUP=1000

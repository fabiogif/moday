# Configuração para Produção SEM Redis (Fallback para File/Sync)

# Cache, Session, Queue e Broadcasting sem Redis
BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Desabilitar Redis explicitamente (opcional)
REDIS_ENABLED=false

# Redis Configuration (opcional, não será usado)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


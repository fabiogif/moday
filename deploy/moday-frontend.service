[Unit]
Description=Alba Tec - Next.js Frontend (porta 3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/moday-frontend/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StartLimitInterval=300
StartLimitBurst=10
StandardOutput=append:/home/ubuntu/apps/moday-frontend/frontend.log
StandardError=append:/home/ubuntu/apps/moday-frontend/frontend.log

[Install]
WantedBy=multi-user.target

# Template de produção — commitado no git
# No servidor: cp .env.production.example .env  (ou use .env.production)

APP_NAME=DistribTec
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dist.albatec.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
FRONTEND_URL=https://dist.albatec.com.br

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=distribtec_production
DB_USERNAME=distribtec_user
DB_PASSWORD=ALTERE_SENHA_FORTE_AQUI
MYSQL_ROOT_PASSWORD=ALTERE_ROOT_FORTE_AQUI

BROADCAST_DRIVER=reverb
CACHE_STORE=redis
CACHE_DRIVER=redis
CACHE_PREFIX=distribtec_cache_
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DRIVER=local
FILESYSTEM_PUBLIC_URL=https://dist.albatec.com.br/storage
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160

SANCTUM_STATEFUL_DOMAINS=dist.albatec.com.br

# Mercado Pago — credenciais de produção (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=APP_USR-fc56f8b1-f978-4ecb-a377-0e00341632b9
MERCADOPAGO_WEBHOOK_SECRET=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=dist.albatec.com.br
REVERB_PORT=443
REVERB_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
MAIL_PORT=587
MAIL_USERNAME=OCID_DO_USUARIO_SMTP@ocid1.tenancy.oc1..SEU_TENANCY_ID.qq.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@distribtec.com.br
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_TO=contato@distribtec.com.br
MAIL_SUPPORT_TO=atendimento@distribtec.com.br
MAIL_PIX_TO=pix@distribtec.com.br
MAIL_PROVIDER=smtp


# Evolution API (WhatsApp) — preenchido pelo deploy-production.sh opção 7
# EVOLUTION_API_URL: URL interna Docker (http://evolution:8080) — não mudar
# EVOLUTION_API_KEY: chave forte de acesso — definida em EVOLUTION_API_KEY=... DEPLOY_OPTION=7 ./deploy-production.sh
# EVOLUTION_SERVER_URL: URL pública da Evolution API (para webhooks do WhatsApp)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_SERVER_URL=https://evolution.albatec.com.br

# Consulta de código de barras (opcional — Cosmos; Open Food Facts é fallback público)
COSMOS_API_TOKEN=
COSMOS_API_BASE_URL=https://api.cosmos.bluesoft.com.br
COSMOS_API_TIMEOUT=2
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_TIMEOUT=3
